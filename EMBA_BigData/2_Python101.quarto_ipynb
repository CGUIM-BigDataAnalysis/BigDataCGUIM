      "source": [
        "## Common Data Structure 資料結構 - Recap\n",
        "\n",
        "::::: columns\n",
        "::: {.column width=\"50%\"}\n",
        "-   序列 (sequence)\n",
        "    -   表 (list) `[]`\n",
        "    -   定值表 (tuple) `()`\n",
        "    -   範圍 (range) `range()`\n",
        "-   映射 (mapping)\n",
        "    -   字典 (dist) `{key:value}`\n",
        ":::\n",
        "\n",
        "::: {.column width=\"50%\"}\n",
        "-   矩陣 (matrix, array)\n",
        "    -   一般矩陣\n",
        "    -   numpy矩陣\n",
        "-   資料框 (data frame)\n",
        "    -   pandas 資料框\n",
        ":::\n",
        ":::::"
